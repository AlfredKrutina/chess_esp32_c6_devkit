# Azure AI Foundry — šablona pro Coach (OpenAI-kompatibilní).
# Zkopíruj tento soubor na .env (nebo .env.local) a vyplň hodnoty.
# Soubory .env / .env.local se necommitují. Nastavení v aplikaci má přednost.

# Základní URL bez /chat/completions — např. https://<resource>.openai.azure.com/openai/v1
# (stačí i https://<resource>.openai.azure.com — aplikace doplní /openai/v1)
AZURE_FOUNDRY_BASE_URL=

# API klíč z Azure portálu / Foundry (hlavička api-key, ne Bearer jako u Gemma/local)
AZURE_FOUNDRY_API_KEY=

# Název nasazení (deployment) — jde do těla JSON jako "model"
AZURE_FOUNDRY_DEPLOYMENT=

# Volitelné: jen pro legacy URL …/openai/deployments/<name> (např. 2024-06-01).
# U cesty /openai/v1 nechte prázdné.
AZURE_FOUNDRY_API_VERSION=

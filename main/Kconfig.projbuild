menu "CzechMate firmware"

config CHESS_ENABLE_TEST_TASK
    bool "Test task (UART commands, automated tests)"
    default y
    help
        Enables FreeRTOS test_task (~4 KiB stack) and the test command queue.

        Enabled: UART/test commands for HW diagnostics work.
        Disabled: saves RAM and fewer logs — suitable for production flash.

config CHESS_ENABLE_WEB_SERVER
    bool "HTTP web server (WiFi AP/STA, REST API, WebSocket, PNG)"
    default y
    help
        Enables full web_server_task: WiFi hotspot/STA, REST, WebSocket,
        embedded piece PNGs and browser pages.

        Disabled: a light BLE/UART bridge remains (snapshot, opening trainer via GATT).
        Saves flash/RAM — no esp_http_server, mDNS, or HTTP handlers.

        For a BLE-only factory profile use sdkconfig.defaults.ble_only.
        After change: idf.py fullclean reconfigure build

menu "Game safety and LED hints"
    help
        Controls three independent systems on the physical board:

        1) Matrix guard — pauses the game when sensors disagree with logic
        2) Error recovery — illegal move (red LED, game lock)
        3) Move hints — normal play (blue/yellow move hints)

        First pick a preset; options below can override it after reconfigure.

choice CHESS_GAMEPLAY_PROFILE
    prompt "Preset — summary of guard + errors + LED"
    default CHESS_GAMEPLAY_PROFILE_FULL
    help
        Quick choice for overall behaviour. FULL = current production.

        FULL     — guard + lock on error + all LED hints
        DEV      — no matrix guard (opening development), errors and hints on
        LITE     — no guard, no lock, minimal LED (club/factory)
        FACTORY  — error detection in log only, no LED and no game stop

config CHESS_GAMEPLAY_PROFILE_FULL
    bool "FULL — production (guard + error lock + LED hints)"

config CHESS_GAMEPLAY_PROFILE_DEV
    bool "DEV — opening development (no matrix guard, errors on)"

config CHESS_GAMEPLAY_PROFILE_LITE
    bool "LITE — quiet mode (no guard, no lock, minimal LED)"

config CHESS_GAMEPLAY_PROFILE_FACTORY
    bool "FACTORY — factory test (log only, no LED and no lock)"

endchoice


menu "① Matrix guard — matrix vs. logic mismatch"

config CHESS_MG_ENABLE
    bool "Detect mismatch (2× lift / ghost piece → pause)"
    default y if CHESS_GAMEPLAY_PROFILE_FULL
    default n
    help
        When the physical matrix disagrees with the logical board[], the game
        pauses and the client receives matrix_guard_active=true.

        Disabled: ambiguous states are only logged, moves continue.
        Opening virtual / puzzle guard still ignore them (conflict mode).

config CHESS_MG_FREEZE_MOVES
    bool "Freeze move flow while guard is active"
    depends on CHESS_MG_ENABLE
    default y
    help
        Enabled: further pickup/drop are not processed until the board matches.
        Disabled: guard only reports state; moves can still go through (not recommended).

config CHESS_MG_AUTO_CLEAR
    bool "Auto-clear guard when board matches"
    depends on CHESS_MG_ENABLE
    default y
    help
        When the matrix matches logic, guard clears itself without GUARD_CLEAR.

config CHESS_MG_NVS_RESYNC
    bool "After NVS start, check board (resync guard)"
    depends on CHESS_MG_ENABLE
    default y
    help
        After restoring a saved game, activate guard if the physical board mismatches.
        restore_state.resync_required in JSON.

menu "LED colours during matrix guard"
    depends on CHESS_MG_ENABLE

config CHESS_MG_LED_ENABLE
    bool "Show coloured LEDs during guard"
    default y
    help
        Disabled: guard may run, but the board stays dark (quiet mode).

config CHESS_MG_LED_WHITE_YELLOW
    bool "Yellow — white piece on mismatched square"
    depends on CHESS_MG_LED_ENABLE
    default y

config CHESS_MG_LED_BLACK_BLUE
    bool "Blue — black piece on mismatched square"
    depends on CHESS_MG_LED_ENABLE
    default y

config CHESS_MG_LED_GHOST_ORANGE
    bool "Orange — sensor sees a piece, logic has empty (ghost)"
    depends on CHESS_MG_LED_ENABLE
    default y

config CHESS_MG_LED_MISSING_WHITE
    bool "White — logic has a piece, sensor is empty (missing)"
    depends on CHESS_MG_LED_ENABLE
    default y

endmenu

endmenu

menu "② Error recovery — illegal physical move"

config CHESS_ER_ENABLE
    bool "Detect illegal move on the board"
    default y
    help
        Firmware reacts to a physical move that breaks chess rules.

        Disabled: error only in UART/JSON without recovery logic.

config CHESS_ER_LOCK_GAME
    bool "Lock game until move is corrected (error_state.active)"
    depends on CHESS_ER_ENABLE
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n
    help
        Enabled: further moves blocked until the player returns the piece.
        Disabled: app/JSON error_state.active stays false.

config CHESS_ER_MUTATE_BOARD
    bool "Sync logical board with physical (piece on wrong square)"
    depends on CHESS_ER_ENABLE
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n
    help
        Enabled: board[] copies physical reality for correct pickup recovery.
        Disabled: logic stays "correct"; app may show differently than the board.

config CHESS_ER_LED_RED_PERSIST
    bool "Red LED permanently on invalid square"
    depends on CHESS_ER_ENABLE
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n

config CHESS_ER_LED_RED_BLINK
    bool "Red blink on new move error"
    depends on CHESS_ER_ENABLE
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n

config CHESS_ER_LED_VALID_BLUE
    bool "Blue LED — where to return the piece / legal recovery moves"
    depends on CHESS_ER_ENABLE
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n
    help
        After lifting a piece from the red square, shows the original valid
        position and legal targets. Independent of move hints (normal play).

endmenu

menu "③ Move hints — hints during normal play"

config CHESS_MH_ENABLE
    bool "Enable LED move hints (outside error recovery)"
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n
    help
        Controls blue/yellow hints during normal play. Does not affect matrix guard LED.

config CHESS_MH_LEGAL_MOVES_BLUE
    bool "Blue — legal target squares after lifting a piece"
    depends on CHESS_MH_ENABLE
    default y
    help
        Green/orange capture remains per LED guidance level at runtime.

config CHESS_MH_CASTLING_BLUE
    bool "Blue — castling squares (king + rook)"
    depends on CHESS_MH_ENABLE
    default y

config CHESS_MH_PROMOTION_BLUE
    bool "Blue — promotion buttons (LED 64–71)"
    depends on CHESS_MH_ENABLE
    default y

config CHESS_MH_MOVABLE_YELLOW
    bool "Yellow — pieces that can move (side to move)"
    depends on CHESS_MH_ENABLE
    default y
    help
        After a valid move or new game, highlights movable pieces.

endmenu

menu "Diagnostics — serial link (UART)"

config CHESS_DIAG_UART_ERROR_DETAIL
    bool "Detailed illegal-move explanation on UART (Reason/Solution)"
    default y if CHESS_GAMEPLAY_PROFILE_FULL || CHESS_GAMEPLAY_PROFILE_DEV
    default n
    help
        Enabled: print_error_detail prints reason and guidance (more text).
        Disabled: short error message only.

endmenu

endmenu

endmenu

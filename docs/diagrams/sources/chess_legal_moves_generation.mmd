%% Legal move generation — legal_moves_buffer buffer game_task.c
%%{init: {'theme':'dark','themeVariables':{'fontFamily':'system-ui,sans-serif','clusterBkg':'#0f172a','clusterBorder':'#334155','lineColor':'#94a3b8','primaryTextColor':'#f1f5f9','edgeLabelBackground':'#1e293b','titleColor':'#f8fafc'}}}%%
flowchart TD
  G([game_generate_legal_moves player]) --> CLR[legal_moves_count = 0]
  CLR --> LOOP[for each square 8×8]
  LOOP --> OWN{game_is_own_piece?}
  OWN -->|no| LOOP
  OWN -->|yes| TYP{piece type}

  TYP -->|pawn| GP[game_generate_pawn_moves]
  TYP -->|knight| GK[game_generate_knight_moves]
  TYP -->|bishop/rook/queen| GS[game_generate_sliding_moves directions]
  TYP -->|king| GKng[game_generate_king_moves — moves + castling conditions]

  GP --> SIM[each candidate → game_simulate_move_check]
  GK --> SIM
  GS --> SIM
  GKng --> SIM

  SIM -->|true| BUF[write to legal_moves_buffer · increment]
  SIM -->|false| DROP[discard — king would be in check]
  BUF --> LOOP
  DROP --> LOOP

  LOOP --> RET([return legal_moves_count])

  NOTE["Tip: game_validate_move_enhanced calls game_generate_legal_moves and looks for from/to match in buffer"]:::note
  RET -.-> NOTE

  classDef note fill:#713f12,stroke:#facc15,color:#fef08a

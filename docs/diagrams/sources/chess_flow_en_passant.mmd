flowchart TD
  subgraph SET["After pawn double-step"]
    D2[pawn advances 2 squares] --> EX[game_execute_move_enhanced at end of move]
    EX --> EP[en_passant_available = true]
    EP --> FLD[en_passant_target_* · victim_row/col = where opponent landed]
  end

  FLD -.->|"attacker's move"| PENTRY[pawn diagonally onto "empty" square beside double-step]

  subgraph VAL["Validation"]
    PENTRY --> GP[game_validate_pawn_move_enhanced]
    GP --> CH[game_is_en_passant_possible]
    CH --> R1{has_last_move · last move was pawn by 2?}
    R1 -->|no| X[false]
    R1 --> R2{attacker on last_move_to_row · adjacent file?}
    R2 --> R3{target = middle rank between start/end of opponent · file = opponent file}
    R3 -->|yes| OK[valid en passant move]
  end

  subgraph EXEC["Execution"]
    OK --> MT[MOVE_TYPE_EN_PASSANT in extended_move]
    MT --> RM[game_execute_move_enhanced: remove victim on en_passant_victim_* before base move]
    RM --> BD[pawn on to_square · next move clears en_passant on update]
  end

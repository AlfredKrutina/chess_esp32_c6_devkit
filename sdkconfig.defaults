# ESP32-C6 Chess v2.4 — default Kconfig for a new build / clone.
# Keep in sync with `sdkconfig`: after changing defaults often run `idf.py fullclean reconfigure build`.
# Keys here override IDF factory defaults; `sdkconfig` itself holds the full tree from menuconfig.
CONFIG_IDF_TARGET="esp32c6"

# CzechMate — automated test task (disable to save ~4.5 KiB stack + TCB)
# CONFIG_CHESS_ENABLE_TEST_TASK is not set

# HTTP web server — disable for BLE-only / smaller firmware (no REST, WS, PNG embeds):
CONFIG_CHESS_ENABLE_WEB_SERVER=y

# Gameplay safety profile (FULL — production defaults)
CONFIG_CHESS_GAMEPLAY_PROFILE_FULL=y
CONFIG_CHESS_MG_ENABLE=y
CONFIG_CHESS_MG_FREEZE_MOVES=y
CONFIG_CHESS_MG_AUTO_CLEAR=y
CONFIG_CHESS_MG_NVS_RESYNC=y
CONFIG_CHESS_MG_LED_ENABLE=y
CONFIG_CHESS_MG_LED_WHITE_YELLOW=y
CONFIG_CHESS_MG_LED_BLACK_BLUE=y
CONFIG_CHESS_MG_LED_GHOST_ORANGE=y
CONFIG_CHESS_MG_LED_MISSING_WHITE=y
CONFIG_CHESS_ER_ENABLE=y
CONFIG_CHESS_ER_LOCK_GAME=y
CONFIG_CHESS_ER_MUTATE_BOARD=y
CONFIG_CHESS_ER_LED_RED_PERSIST=y
CONFIG_CHESS_ER_LED_RED_BLINK=y
CONFIG_CHESS_ER_LED_VALID_BLUE=y
CONFIG_CHESS_MH_ENABLE=y
CONFIG_CHESS_MH_LEGAL_MOVES_BLUE=y
CONFIG_CHESS_MH_CASTLING_BLUE=y
CONFIG_CHESS_MH_PROMOTION_BLUE=y
CONFIG_CHESS_MH_MOVABLE_YELLOW=y
CONFIG_CHESS_DIAG_UART_ERROR_DETAIL=y

# HTTP server — WebSocket /ws (watchOS/iOS); without it the client gets “bad response” (-1011)
CONFIG_HTTPD_WS_SUPPORT=y

# System
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3

# USB Serial JTAG Console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_NONE is not set

# JTAG Configuration (keep GPIO0-5 free for debugging)
CONFIG_ESP_SYSTEM_GDBSTUB_RUNTIME=n

# Watchdog Configuration
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# NVS Configuration
CONFIG_NVS_ENCRYPTION=n

# Security Configuration
CONFIG_SECURE_BOOT_V2_ENABLED=n

# WiFi — required for web_server (AP/STA), HTTP, WebSocket, mDNS. Without it the LAN app path does not work.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

# Bluetooth — NimBLE GATT (CZECHMATE). After changing, run `idf.py fullclean reconfigure build`.
# If sdkconfig overrides defaults, enable BT in menuconfig Component config → Bluetooth.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Larger MSYS pool — with AP/STA + HTTP the default may be too small for ATT; helps against “0 services” on iOS.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=32
# Host task: default 4096 is not enough — GATT snapshot read calls build_snapshot (clock_json ~1 KiB on stack)
# + NimBLE/HS + coexistence → Guru Meditation “Stack protection fault” in nimble_host (see log).
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# Bonding keys in NVS — pairing survives board reboot (iOS/Android); requires ble_store_config_init().
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# INFO logs every GATT notify (snapshot chunks) — floods the serial port; WARNING is enough for errors/warnings.
# CONFIG_BT_NIMBLE_LOG_LEVEL_INFO is not set
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# WiFi + BLE on one chip (required for stable dual operation).
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Debug Configuration
CONFIG_ESP_DEBUG_STUBS_ENABLE=y
CONFIG_ESP_DEBUG_OCDAWARE=y

# Component Configuration
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NONE=y

# Build Configuration — default 16 MB flash + partitions.csv (dual OTA + stm32_fw).
# Module that actually has 4 MB flash → switch to CONFIG_ESPTOOLPY_FLASHSIZE_4MB and
# partitions_4mb_factory_only.csv or partitions_4mb_dual_ota.csv (small build only).
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# Partition Table Configuration
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback — new image must call esp_ota_mark_app_valid_cancel_rollback() in main.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# --- Matrix input (build-time choice) ---
# Reed: matrix_scan_all() does GPIO multiplex 8×8 (see matrix_task.c + MATRIX_* in freertos_chess.h).
# Hall: hall_i2c_matrix_fill_state() reads 4× STM over I2C (hall_i2c_spec.h).
#
# To restore “STM flash over I2C at runtime”:
# - idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.hall_v2" build flash
# - menuconfig: CHESS_MATRIX_INPUT_I2C_HALL + CHESS_STM32_I2C_BL_ENABLE (+ often CHESS_STM32_BL_SHARE_I2C_HALL=y).
# - Wiring: docs/reference/WIRING_ESP_STM4.md
CONFIG_CHESS_MATRIX_INPUT_GPIO_REED=y
# CONFIG_CHESS_MATRIX_INPUT_I2C_HALL is not set

# STM32 ROM bootloader (AN4221) — disabled in the reed profile due to the pin clash above.
# CONFIG_CHESS_STM32_I2C_BL_ENABLE is not set

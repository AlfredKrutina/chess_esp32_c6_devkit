%% game_is_valid_move — check chain before executing a move game_task.c
%%{init: {'theme':'dark','themeVariables':{'fontFamily':'system-ui,sans-serif','clusterBkg':'#0f172a','clusterBorder':'#334155','lineColor':'#94a3b8','primaryTextColor':'#f1f5f9','edgeLabelBackground':'#1e293b','titleColor':'#f8fafc'}}}%%
flowchart TD
  V([game_is_valid_move]) --> N{move NULL?}
  N -->|yes| E1[MOVE_ERROR_INVALID_MOVE_STRUCTURE]
  N -->|no| BOUNDS{from/to in 0–7?}
  BOUNDS -->|no| E2[MOVE_ERROR_OUT_OF_BOUNDS]
  BOUNDS -->|yes| ACT{game_active?}
  ACT -->|no| E3[MOVE_ERROR_GAME_NOT_ACTIVE]
  ACT -->|yes| SRC[source_piece from board · resignation king exception]

  SRC --> COLOR{belongs to current_player?}
  COLOR -->|no| E4[MOVE_ERROR_WRONG_COLOR]
  COLOR -->|yes| OWN{dest own piece?}
  OWN -->|yes| E5[MOVE_ERROR_DESTINATION_OCCUPIED]
  OWN -->|no| CAST{castling — expected rook move?}

  CAST -->|yes correct| SKIP[skip standard rook geometry]
  CAST -->|no / not castling| PIECE[game_validate_piece_move_enhanced]
  CAST -->|wrong move during castling| E_CAST[MOVE_ERROR_CASTLING_BLOCKED]
  SKIP --> CHECK
  PIECE --> PE{MOVE_ERROR_NONE?}
  PE -->|no| EP[own piece_error]
  PE -->|yes| CHECK{game_would_move_leave_king_in_check?}

  CHECK -->|yes| E6[MOVE_ERROR_KING_IN_CHECK]
  CHECK -->|no| OK[MOVE_ERROR_NONE]

%% Lifting the king — 10s to resign or cancel game_task.c
%%{init: {'theme':'dark','themeVariables':{'fontFamily':'system-ui,sans-serif','clusterBkg':'#0f172a','clusterBorder':'#334155','lineColor':'#94a3b8','primaryTextColor':'#f1f5f9','edgeLabelBackground':'#1e293b','titleColor':'#f8fafc'}}}%%
flowchart TD
  L[PICKUP own king on move] --> RS[resignation_start]
  RS --> RM[board at king_sq empty · resignation_state active]
  RM --> LED[orange source · LED legal king moves incl. blue castling]

  LED --> LOOP[game_process_commands — each pass]
  LOOP --> RT[resignation_tick]
  RT --> T{elapsed ≥ 10 s?}
  T -->|yes| FIN[resignation_finalize_timeout — RESIGNATION · animation · resignation_stop true]
  T -->|no| BTN[resignation_update_button_leds]
  BTN --> LOOP

  LED -.-> DR[user: DROP king on original square]
  DR --> ST[resignation_stop false — king back on board]

  LED -.-> CAP[user: king captures a piece — capture]
  CAP --> ST2[resignation_stop false before game_execute_move]

  RS -.-> IMPL[Finalize only from game_task via resignation_tick — not from Tmr Svc callback]

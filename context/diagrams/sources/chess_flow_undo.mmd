%% Undo last move — game_undo_last_move_impl
%%{init: {'theme':'dark','themeVariables':{'fontFamily':'system-ui,sans-serif','clusterBkg':'#0f172a','clusterBorder':'#334155','lineColor':'#94a3b8','primaryTextColor':'#f1f5f9','edgeLabelBackground':'#1e293b','titleColor':'#f8fafc'}}}%%
flowchart TD
  U[GAME_CMD_UNDO_MOVE] --> CH{history_index > 0?}
  CH -->|no| FAIL([false])
  CH -->|yes| BR[switch move_history_kind: EN_PASSANT restores victim · PROMOTION restores pawn/captured · CAPTURE/NORMAL rewrites squares]

  BR --> RK{kind CASTLE_* ?}
  RK -->|yes| RU[if rook stands on mid-file → back to a/h · castling_state.in_progress = false]
  RK -->|no| SK1[—]

  RU --> CAP{MOVE_TYPE_CAPTURE?}
  SK1 --> CAP
  CAP -->|yes| POP[undo_pop_last_capture_list — EP handled by switch above]
  CAP -->|no| SK2[—]

  POP --> META[history_index--; move_count--; mover counters · compute toggle_player_after]
  SK2 --> META

  META --> SW[possibly switch current_player]
  SW --> LM[last_move from previous record]
  LM --> RST{was FINISHED before undo?}
  RST -->|yes| ACTIVE[GAME_STATE_ACTIVE · game_active]
  RST -->|no| SK3[—]

  ACTIVE --> POST[piece_lifted=0 · timers for current_player]
  SK3 --> POST

  POST --> RSYNC[game_check_resync_needed_after_restore]
  RSYNC --> MG{matrix_guard.active?}
  MG -->|no| HL[LED + highlight movable]
  MG -->|yes| LOG[staging log only]

  HL --> PERSIST[game_persist_after_valid_move · bump revision]
  LOG --> PERSIST
  PERSIST --> OK([true])

# =============================================================================
# Nativní iOS (Xcode) — v remote jen Flutter klient flutter_czechmate/
# =============================================================================
/CZECHMATE/

# =============================================================================
# Podklady pro AI / interní plány — nejsou součástí hlavní dokumentace v remote
# (zdroj pravdy pro lidi: kořenové README.md + docs/README.md + reference/ + diagrams/)
# =============================================================================
# Cursor IDE — lokální plány agentů, náhledy chatů, workspace cache (nesdílet)
.cursor/

# Složky „context“ kam dáváš soubory pro AI (kořen i např. flutter_czechmate/context/)
**/context/

/docs/archive/
/docs/planning/

# Lokální backlog / nápady na diagramy (necommitovat — dlouhý osobní seznam)
/docs/diagrams/LOCAL_DIAGRAM_BACKLOG.md

# Volitelné osobní plány mimo docs/planning (např. export z nástroje)
**/*.local.plan.md

# Osobní learning plán (kořen projektu)
/LEARNING_PLAN.md

# Lokální poznámky (inventáře rizik, checklisty mimo Git — celá složka)
/private-notes/

# Lokální kopie UI auditu Flutter klienta (primární soubor je vedle repozitáře: ../flutter_czechmate_UI_AUDIT.md)
/flutter_czechmate_UI_AUDIT.md


# =============================================================================
# ESP-IDF / toolchain
# =============================================================================
# Kořenový výstup `idf.py build` — nikdy commitovat. Pokud už historicky ve sledování:
#   git rm -r --cached build/
/build/

# Lokální CMake výstup omylem spuštěný uvnitř komponenty (IDE / debug)
components/*/build/

/sdkconfig.old

# Doxygen výstup (generuj: ./generate_docs.sh)
/docs/doxygen/html/
/docs/doxygen/rtf/
/docs/doxygen/latex/
/docs/doxygen/*.tag
/docs/doxygen/generation.log
/docs/doxygen/doxygen_warnings.log

# ESP-IDF — závislosti z Component Manageru (obnovíš: idf.py build / reconfigure)
/managed_components/

# GitHub Pages: statické soubory pro nasazení + README; zbytek generuje CI (Doxygen/Mermaid)
/gh-pages-ready/*
!/gh-pages-ready/README.md
!/gh-pages-ready/.nojekyll
!/gh-pages-ready/downloads.html
!/gh-pages-ready/app_update.json
!/gh-pages-ready/app_update.html
!/gh-pages-ready/serve.sh
!/gh-pages-ready/serve.cmd
!/gh-pages-ready/serve.ps1
!/gh-pages-ready/landing/
!/gh-pages-ready/landing/**/*

# HLS ABR (~150 MB fMP4) — regeneruj: py -3.12 models/blender/encode_web.py
# Na Pages stačí progressive MP4 (data-hls-fallback). HLS drž lokálně / force-add jen když chceš ABR.
/gh-pages-ready/landing/assets/hls/

# Mezikrok encode_web (poster PNG → WebP)
/gh-pages-ready/landing/assets/*poster.png

# Lokální šum
*.log
*.tmp
*.temp
Thumbs.db
Desktop.ini

# IDE / indexer cache (clangd, ccls, …)
.cache/

# macOS metadata (všude v repu)
**/.DS_Store

# STM32 build artefakty (make v firmware/stm32_hall_c031/)
/firmware/stm32_hall_c031/build/

# Omylem zkompilované objekty v komponentách
components/web_server_task/*.o

# =============================================================================
# STM32 — lokální STM32CubeC0 (ST CMSIS + LL/HAL). Build: firmware/stm32_hall_c031/Makefile
# očekává `firmware/STM32CubeC0` (git clone ST repo sem), do Gitu nedávat.
# =============================================================================
/firmware/STM32CubeC0/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# =============================================================================
# Blender / 3D pipeline (models/blender)
# Commituj: skripty (build_*.py, cine_common, led_*), board/*.glb|stl, timeline JSON.
# Nekommituj: scény .blend (přegenerují se skriptem), video/, MPFB set/, scratch _*.py.
# =============================================================================
# Scény a Blender autosave / crash — vždy znovu z build_*.py
/models/blender/*.blend
/models/blender/*.blend1
/models/blender/*.blend2
*.blend1
*.blend2

# MPFB people / clothes / asset pack (~700+ MB)
/models/blender/set/

# Masterny 4K/FHD, raw, logy renderů (~1+ GB)
/models/blender/video/

# Scratch / one-off diagnostika vedle pipeline
/models/blender/_*.py
/models/blender/preview.png
/models/blender/*.jpg
/models/blender/*.jpeg
/models/blender/*.exr
/models/blender/*.tif
/models/blender/*.tiff

# Náhodný EEVEE/Cycles cache vedle skriptů
/models/blender/cache/
/models/blender/.blender/

# =============================================================================
# Ostatní
# =============================================================================
.vscode/
.idea/
*.swp
*~
